    "serve": "vite preview",
    "lint": "eslint --fix src",
    "ts:check": "tsc --noEmit",
    "vue:check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "@unhead/vue": "2.1.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "@vue/devtools-api": "8.2.1",
    "animejs": "^4.3.6",
    "pinia": "4.1.0",
    "vercel": "^51.2.1",
    "vue": "3.5.42",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@prerenderer/prerenderer": "^1.2.5",
