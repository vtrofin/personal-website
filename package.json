{
  "name": "trofin.me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve_api": "vercel dev --listen 3002",
    "build": "rm -rf dist && VUE_APP_SSG=false vite build",
    "build:ssg": "rm -rf dist && VUE_APP_SSG=true vite-ssg build",
    "serve": "vite preview",
    "lint": "eslint --fix src",
    "ts:check": "tsc --noEmit",
    "vue:check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "@unhead/vue": "3.4.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "@vue/devtools-api": "8.2.1",
    "animejs": "^4.5.0",
    "pinia": "4.1.0",
    "vercel": "^66.5.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prerenderer/prerenderer": "^1.2.5",
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@types/animejs": "^4.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/compiler-sfc": "3.5.45",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "17.14.0",
    "puppeteer": "^25.18.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-checker": "^1.0.0",
    "vite-ssg": "^28.3.0",
    "vue-svg-loader": "^0.16.0",
    "vue-tsc": "3.3.14"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
