    "@vue/compiler-sfc": "3.5.42",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "17.14.0",
    "puppeteer": "^24.40.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.7",
    "vite-plugin-checker": "^0.12.0",
    "vite-ssg": "^28.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vue-svg-loader": "^0.16.0",
    "vue-tsc": "3.3.14"
